<footer class="ftr">
  <div class="ftr-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <p class="ftr-word display" aria-hidden="true">{{ section.settings.word | default: shop.name | upcase }}</p>
  <div class="ftr-legal">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.note }}</span>
    <span class="credit">{{ section.settings.credit }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Halfstep footer",
  "settings": [
    { "type": "text", "id": "word", "label": "Big word", "default": "HALFSTEP" },
    { "type": "text", "id": "note", "label": "Note", "default": "Halfstep is a fictional brand, built as a Shopify theme demo." },
    { "type": "text", "id": "credit", "label": "Credits", "default": "3D shoe model © 2021 Shopify, CC BY 4.0 (Khronos glTF sample assets). Colourways and renders are our own." }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] }
  ],
  "max_blocks": 4
}
{% endschema %}
