{%- assign word = section.settings.word | default: shop.name | upcase -%}
<footer class="ftr">
  <div class="ftr-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}" data-wipe>{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endfor -%}
    <div class="ftr-note"><p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.note }}</p></div>
  </div>
  <p class="ftr-word" aria-hidden="true">{%- assign chars = word | split: '' -%}{%- for c in chars -%}<span>{{ c }}</span>{%- endfor -%}</p>
  {%- if section.settings.credit != blank -%}<p class="ftr-legal">{{ section.settings.credit }}</p>{%- endif -%}
</footer>

{% schema %}
{
  "name": "Halfstep footer",
  "settings": [
    { "type": "text", "id": "word", "label": "Big word (letters widen near the cursor)", "default": "HALFSTEP" },
    { "type": "text", "id": "note", "label": "Note", "default": "Built for movement. Shipped from London." },
    { "type": "text", "id": "credit", "label": "Credits", "default": "3D shoe model © 2021 Shopify, CC BY 4.0 (Khronos glTF sample assets). Colourways and renders are our own." }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] }
  ],
  "max_blocks": 3
}
{% endschema %}
