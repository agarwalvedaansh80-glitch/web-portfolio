{%- assign word = section.settings.word | upcase | slice: 0, 8 -%}
<section class="drop hs-drop" id="drop" aria-labelledby="drop-h-{{ section.id }}" data-date="{{ section.settings.date | escape }}">
  <div class="board-wrap">
    <div class="board" role="timer" aria-label="{{ section.settings.timer_label | escape }}">
      <div class="board-row board-word" data-word="{{ word | escape }}"></div>
      <div class="board-row board-time"></div>
      <div class="board-labels"><span>Days</span><span>Hours</span><span>Min</span><span>Sec</span></div>
    </div>
    <img class="drop-shoe" src="{{ 'hs-' | append: section.settings.colour_handle | append: '-side.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1400" height="827">
  </div>
  <div class="drop-copy">
    <h2 class="h2" id="drop-h-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', class: 'notify', id: 'hs-drop-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,{{ word | handleize }}-drop">
      <label class="visually-hidden" for="hs-drop-email">Email</label>
      <input id="hs-drop-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email">
      <button class="btn btn--ink" type="submit" data-magnetic=".2" data-cursor="SEND">{{ section.settings.button }}</button>
      <p class="notify-msg" aria-live="polite" data-posted="{% if form.posted_successfully? %}true{% endif %}"></p>
    {%- endform -%}
  </div>
  <canvas class="confetti" aria-hidden="true"></canvas>
</section>

{% schema %}
{
  "name": "Halfstep next drop",
  "settings": [
    { "type": "text", "id": "word", "label": "Word on the split-flap board (up to 8 letters)", "default": "Ember" },
    { "type": "text", "id": "colour_handle", "label": "Colour handle for the shoe image", "default": "ember" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Drift Knit in Ember, side view" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ember lands Saturday" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Burnt orange knit, black stripes. 400 pairs at 10:00 IST. We send one email ten minutes before, and nothing else." },
    { "type": "text", "id": "date", "label": "Drop date and time (ISO, e.g. 2026-10-24T10:00:00+05:30)", "default": "2026-10-24T10:00:00+05:30" },
    { "type": "text", "id": "timer_label", "label": "Timer label (screen readers)", "default": "Time until Ember goes live" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "text", "id": "button", "label": "Button", "default": "Remind me" }
  ],
  "presets": [{ "name": "Halfstep next drop" }]
}
{% endschema %}
