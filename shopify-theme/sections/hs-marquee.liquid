<div class="marquee" aria-hidden="true"><div class="marquee-track">
  {%- for n in (1..2) -%}{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}{%- endfor -%}
</div></div>
{% schema %}
{
  "name": "Halfstep marquee",
  "blocks": [{ "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $120" }] }],
  "presets": [{ "name": "Halfstep marquee", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
