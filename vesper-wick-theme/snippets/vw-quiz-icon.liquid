{%- comment -%} Animated line icons for the scent finder choices. Param: name {%- endcomment -%}
{%- case name -%}
  {%- when 'calm' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle class="an a-ripple" cx="50" cy="50" r="36"/><circle class="an a-ripple d2" cx="50" cy="50" r="36"/><circle class="an a-ripple d3" cx="50" cy="50" r="36"/><circle cx="50" cy="50" r="3" fill="currentColor" stroke="none"/></svg>
  {%- when 'cosy' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M28 46h38v20a14 14 0 0 1-14 14H42a14 14 0 0 1-14-14z"/><path d="M66 52h5a8 8 0 0 1 0 16h-5"/><path class="an a-steam" d="M40 38c-5-6 5-10 0-18"/><path class="an a-steam d2" d="M48 38c-5-6 5-10 0-18"/><path class="an a-steam d3" d="M56 38c-5-6 5-10 0-18"/></svg>
  {%- when 'awake' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="14"/><g class="an a-spin"><path d="M50 22v-8M50 86v-8M22 50h-8M86 50h-8M30 30l-6-6M76 76l-6-6M30 70l-6 6M76 24l-6 6"/></g></svg>
  {%- when 'moody' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M58 20a24 24 0 1 0 22 32 20 20 0 0 1-22-32z"/><path class="an a-drift" d="M12 78c10-6 20 6 32 0s22-6 32 0"/><path class="an a-drift" style="animation-delay:-2s" d="M22 88c8-4 16 4 26 0s18-4 26 0"/></svg>
  {%- when 'living' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M20 62V50a8 8 0 0 1 8-8h40a8 8 0 0 1 8 8v12"/><path d="M14 58h72v14H14z"/><path d="M20 72v6M80 72v6"/><path d="M88 58V24M80 24h16"/><circle class="an a-glow" cx="88" cy="30" r="7" fill="currentColor" stroke="none" opacity=".35"/></svg>
  {%- when 'bedroom' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M14 40v38M14 62h72v16M86 78V62"/><path d="M22 54h18"/><path d="M14 62c0-6 6-8 12-8h56a4 4 0 0 1 4 4v4"/><path class="an a-float" d="M62 34h8l-8 8h8"/><path class="an a-float d2" d="M74 24h6l-6 6h6"/></svg>
  {%- when 'bath' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M12 56h76v6a16 16 0 0 1-16 16H28a16 16 0 0 1-16-16z"/><path d="M22 56V32a7 7 0 0 1 14 0"/><path d="M28 80l-4 6M72 80l4 6"/><circle class="an a-float" cx="54" cy="46" r="4"/><circle class="an a-float d2" cx="66" cy="44" r="3"/><circle class="an a-float d3" cx="60" cy="40" r="2"/></svg>
  {%- when 'study' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M10 74h80"/><path d="M28 68c8-4 14-4 20 0 6-4 12-4 20 0V48c-8-4-14-4-20 0-6-4-12-4-20 0z"/><path d="M48 48v20"/><path d="M78 74V40l-10-10"/><path d="M62 30l8-8 8 8z"/><circle class="an a-glow" cx="70" cy="36" r="6" fill="currentColor" stroke="none" opacity=".3"/></svg>
  {%- when 'spring' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M20 82h60"/><path class="an a-grow" d="M50 82V44"/><path class="an a-grow" d="M50 60c-14 0-20-8-20-20 12 0 20 8 20 20z"/><path class="an a-grow" d="M50 52c12 0 18-8 18-18-11 0-18 7-18 18z"/></svg>
  {%- when 'summer' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="44" r="14"/><path class="an a-wave" d="M4 66c8-6 14-6 22 0s14 6 22 0 14-6 22 0 14 6 22 0 14-6 22 0"/><path class="an a-wave" style="animation-delay:-1.5s" d="M4 78c8-6 14-6 22 0s14 6 22 0 14-6 22 0 14 6 22 0 14-6 22 0"/></svg>
  {%- when 'autumn' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><g class="an a-fall"><path d="M50 26c16 10 18 28 0 44-18-16-16-34 0-44z"/><path d="M50 30v48M50 46l-8-6M50 56l8-6"/></g></svg>
  {%- when 'winter' -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><g class="an a-spin"><path d="M50 20v60M24 35l52 30M24 65l52-30"/><path d="M44 24l6 6 6-6M44 76l6-6 6 6M22 42l8-1-3-8M78 58l-8 1 3 8M22 58l8 1-3 8M78 42l-8-1 3-8"/></g></svg>
  {%- else -%}
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle class="an a-ripple" cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="3" fill="currentColor" stroke="none"/></svg>
{%- endcase -%}
