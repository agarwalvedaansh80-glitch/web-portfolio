<div class="page-wrap">
  <h1>{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label class="sr" for="q">{{ 'general.search' | t }}</label>
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--dark" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    <div class="col-grid" style="padding:0">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'vw-product-card', product: item, index: forloop.index %}{%- endif -%}
      {%- else -%}
        <p>{{ 'general.no_results' | t }}</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search", "tag": "section", "settings": [] }
{% endschema %}
