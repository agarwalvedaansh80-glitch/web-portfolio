{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections.all
  endif
-%}
<section class="quiz bone" id="finder" aria-labelledby="quiz-h-{{ section.id }}" data-quiz data-result-label="{{ section.settings.result_label | escape }}">
  <div class="quiz-head">
    <div>
      {%- if section.settings.label != blank -%}<span class="label" style="display:block;margin-bottom:18px">{{ section.settings.label | escape }}</span>{%- endif -%}
      <h2 class="h2 split" id="quiz-h-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div style="display:grid;gap:16px;justify-items:end">
      {%- if section.settings.text != blank -%}<p class="lede" style="text-align:right">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="quiz-prog" aria-live="polite">{%- for block in section.blocks -%}<i></i>{%- endfor -%}<b>01 / {{ section.blocks.size | prepend: '0' }}</b></div>
    </div>
  </div>
  <div class="quiz-stage">
    {%- for block in section.blocks -%}
      <div class="qstep" data-q="{{ block.settings.key }}" data-weight="{{ block.settings.weight | divided_by: 10.0 }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <div class="choices">
          {%- for i in (1..4) -%}
            {%- assign lk = 'label_' | append: i -%}{%- assign sk = 'sub_' | append: i -%}{%- assign vk = 'value_' | append: i -%}{%- assign ik = 'icon_' | append: i -%}{%- assign ck = 'color_' | append: i -%}
            {%- if block.settings[lk] != blank -%}
              <button class="choice" type="button" data-v="{{ block.settings[vk] | default: block.settings[lk] | handleize }}" style="--cc: {{ block.settings[ck] }}" aria-pressed="false">
                <span class="k">{{ 'ABCD' | slice: forloop.index0 }}</span>
                {% render 'vw-quiz-icon', name: block.settings[ik] %}
                <span><b>{{ block.settings[lk] | escape }}</b>{%- if block.settings[sk] != blank -%}<small>{{ block.settings[sk] | escape }}</small>{%- endif -%}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
    <div class="qstep qresult" data-q="result" aria-live="polite"></div>
  </div>
  <button class="quiz-back" type="button">← {{ 'sections.quiz.back' | t }}</button>
  <script type="application/json" data-quiz-products>
    [
    {%- for p in coll.products limit: 40 -%}
      {%- liquid
        assign v = p.selected_or_first_available_variant
        capture feel
          render 'vw-feel', product: p
        endcapture
        capture pyramid
          render 'vw-notes', product: p, style: 'pyramid', accent: p.metafields.custom.accent_color.value
        endcapture
      -%}
      {
        "id": {{ p.id | json }},
        "variant": {{ v.id | json }},
        "available": {{ v.available | json }},
        "title": {{ p.title | json }},
        "url": {{ p.url | json }},
        "price": {{ v.price | money | json }},
        "image": {{ p.featured_image | image_url: width: 900 | json }},
        "accent": {{ p.metafields.custom.accent_color.value | default: settings.color_ember | json }},
        "feel": {{ feel | strip | json }},
        "number": {{ p.metafields.custom.scent_number.value | json }},
        "tagline": {{ p.metafields.custom.tagline.value | json }},
        "profile": {{ p.metafields.custom.quiz_profile.value | json }},
        "tags": {{ p.tags | json }},
        "pyramid": {{ pyramid | strip_newlines | json }},
        "heart": {{ p.metafields.custom.heart_notes.value | json }},
        "base": {{ p.metafields.custom.base_notes.value | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>
</section>

