        "min": 24,
        "max": 96,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "smooth_scroll",
        "label": "Smooth scrolling (Lenis)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "custom_cursor",
        "label": "Ember cursor and magnetic buttons",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "Visitors who ask their device for reduced motion always get a calm version with no smoke animation, smooth scrolling or pinned scenes."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
