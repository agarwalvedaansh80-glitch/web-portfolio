        "s1": {
          "type": "step",
          "settings": {
            "title": "Poured at 62°",
            "text": "Coconut and rapeseed wax, melted slowly and poured at 62°C so the fragrance binds instead of flashing off. A run is 120 jars, never more."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Centred by hand",
            "text": "A waxed cotton wick, held dead centre by a beech bar while the jar sets. Off-centre wicks tunnel; ours burn flat to the edge."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Cured for fourteen days",
            "text": "Fragrance needs two weeks to marry the wax. We wait, so your first burn smells like the hundredth."
          }
        }
      },
